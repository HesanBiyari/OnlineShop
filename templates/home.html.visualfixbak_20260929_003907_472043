{% extends "base.html" %}
{% block title %}Giftbaaz | فروشگاه محصولات دیجیتال{% endblock %}
{% block content %}
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy reveal">
      <span class="hero-kicker">فروشگاه دیجیتال نسل جدید</span>
      <h1>خرید دیجیتال،<br><span>سریع‌تر و مطمئن‌تر.</span></h1>
      <p>گیفت کارت و محصولات دیجیتال را پیدا کن، انتخاب کن و سفارش بده؛ همه‌چیز با یک تجربه ساده و شفاف.</p>
      <div class="hero-actions"><a class="btn btn-primary" href="{% url 'shop' %}">مشاهده فروشگاه <span>←</span></a>{% if not user.is_authenticated %}<a class="btn btn-ghost" href="{% url 'signup' %}">ساخت حساب</a>{% endif %}</div>
      <div class="hero-proof"><span>✓ خرید قابل پیگیری</span><span>✓ تحویل دیجیتال</span><span>✓ تجربه امن</span></div>
    </div>
    <div class="hero-visual reveal" data-parallax><img class="hero-art" src="{% static 'assets/hero/giftbaaz-hero.svg' %}" alt="Giftbaaz digital gifts"></div>
  </div>
</section>

{% if categories %}<section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">دسته‌بندی‌ها</span><h2>چیزی که می‌خواهی را سریع پیدا کن</h2></div><a class="text-link" href="{% url 'shop' %}">همه محصولات ←</a></div><div class="category-grid">{% for category in categories %}<a class="category-card reveal" href="{% url 'shop' %}?category={{ category.slug }}"><span class="category-icon">
{% if "game" in category.slug or "gaming" in category.slug %}
<svg class="ui-icon ui-icon--md"><use href="{% static 'assets/giftbaaz-ui.svg' %}#game"></use></svg>
{% elif "gift" in category.slug or "card" in category.slug %}
<svg class="ui-icon ui-icon--md"><use href="{% static 'assets/giftbaaz-ui.svg' %}#gift"></use></svg>
{% elif "soft" in category.slug %}
<svg class="ui-icon ui-icon--md"><use href="{% static 'assets/giftbaaz-ui.svg' %}#laptop"></use></svg>
{% elif "mobile" in category.slug or "top" in category.slug %}
<svg class="ui-icon ui-icon--md"><use href="{% static 'assets/giftbaaz-ui.svg' %}#phone"></use></svg>
{% elif "entertain" in category.slug or "stream" in category.slug %}
<svg class="ui-icon ui-icon--md"><use href="{% static 'assets/giftbaaz-ui.svg' %}#play"></use></svg>
{% else %}
<svg class="ui-icon ui-icon--md"><use href="{% static 'assets/giftbaaz-ui.svg' %}#grid"></use></svg>
{% endif %}
</span><strong>{{ category.name }}</strong><small>مشاهده محصولات ←</small></a>{% endfor %}</div></div></section>{% endif %}

{% if featured_products %}<section class="section section-soft"><div class="container"><div class="section-head"><div><span class="eyebrow">منتخب فروشگاه</span><h2>محصولات ویژه</h2></div><a class="text-link" href="{% url 'shop' %}">مشاهده همه ←</a></div><div class="product-grid">{% for product in featured_products %}{% include "partials/product_card.html" with product=product %}{% endfor %}</div></div></section>{% endif %}

<section class="section bestseller-section" id="bestsellers"><div class="container"><div class="section-head"><div><span class="eyebrow">محبوب‌ترین‌ها</span><h2>محصولات پرفروش</h2></div><a class="text-link" href="{% url 'shop' %}">مشاهده همه ←</a></div><div class="product-grid">{% for product in bestseller_products %}{% include "partials/product_card.html" with product=product %}{% empty %}<div class="empty-state"><div><svg class="ui-icon ui-icon--lg"><use href="{% static 'assets/giftbaaz-ui.svg' %}#star"></use></svg></div><h2>هنوز پرفروشی مشخص نشده</h2><p>از پنل مدیریت محصولات پرفروش را انتخاب کن.</p></div>{% endfor %}</div></div></section>

<section class="trust-strip"><div class="container trust-grid"><div><b>⚡</b><span><strong>سریع</strong>فرآیند خرید بدون پیچیدگی</span></div><div><b><svg class="ui-icon ui-icon--md"><use href="{% static 'assets/giftbaaz-ui.svg' %}#lock"></use></svg></b><span><strong>امن</strong>حفاظت از حساب و فرم‌ها</span></div><div><b><svg class="ui-icon ui-icon--md"><use href="{% static 'assets/giftbaaz-ui.svg' %}#code"></use></svg></b><span><strong>دیجیتال</strong>نمایش کد در سفارش</span></div><div><b><svg class="ui-icon ui-icon--md"><use href="{% static 'assets/giftbaaz-ui.svg' %}#share"></use></svg></b><span><strong>قابل پیگیری</strong>تاریخچه سفارش‌ها</span></div></div></section>

{% if new_products %}<section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">تازه واردها</span><h2>جدیدترین محصولات</h2></div><a class="text-link" href="{% url 'shop' %}?sort=newest">مشاهده همه ←</a></div><div class="product-grid">{% for product in new_products %}{% include "partials/product_card.html" with product=product %}{% endfor %}</div></div></section>{% endif %}

<section class="section section-soft"><div class="container"><div class="section-head centered"><div><span class="eyebrow">مسیر خرید</span><h2>چهار قدم تا سفارش</h2></div></div><div class="steps-grid"><div class="step reveal"><i>۱</i><h3>انتخاب</h3><p>محصول و گزینه مناسب را پیدا کن.</p></div><div class="step reveal"><i>۲</i><h3>سبد</h3><p>تعداد و موجودی را بررسی کن.</p></div><div class="step reveal"><i>۳</i><h3>ثبت</h3><p>اطلاعات سفارش را وارد کن.</p></div><div class="step reveal"><i>۴</i><h3>تحویل</h3><p>کد دیجیتال را در سفارش ببین.</p></div></div></div></section>

<section class="section faq-section"><div class="container narrow"><div class="section-head centered"><div><span class="eyebrow">راهنما</span><h2>سؤالات متداول</h2></div></div><div class="faq-list"><details><summary>آیا برای خرید حساب لازم است؟</summary><p>برای ثبت سفارش و مشاهده سفارش‌ها باید وارد حساب کاربری شوید.</p></details><details><summary>کد دیجیتال کجا نمایش داده می‌شود؟</summary><p>پس از تکمیل سفارش، کدهای تحویل‌شده در جزئیات همان سفارش نمایش داده می‌شوند.</p></details><details><summary>اگر موجودی کافی نباشد چه می‌شود؟</summary><p>سفارش طبق وضعیت پردازش سیستم ادامه پیدا می‌کند تا موجودی لازم فراهم شود.</p></details></div></div></section>
{% endblock %}