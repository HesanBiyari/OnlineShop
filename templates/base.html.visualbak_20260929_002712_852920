{% load static %}
<!doctype html>
<html lang="fa" dir="rtl" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#090b12">
  <meta name="color-scheme" content="dark">
  <title>{% block title %}Giftbaaz{% endblock %}</title>
  <meta name="description" content="{% block meta_description %}فروشگاه حرفه‌ای محصولات دیجیتال و گیفت کارت{% endblock %}">
  <link rel="canonical" href="{{ request.scheme }}://{{ request.get_host }}{{ request.path }}">
  <meta property="og:title" content="{% block og_title %}Giftbaaz{% endblock %}">
  <meta property="og:description" content="{% block og_description %}فروشگاه محصولات دیجیتال و گیفت کارت{% endblock %}">
  <meta property="og:url" content="{{ request.scheme }}://{{ request.get_host }}{{ request.path }}">
  <meta property="og:type" content="website">
  <link rel="icon" href="{% static 'assets/branding/giftbaaz-mark.svg' %}" type="image/svg+xml">
  <link rel="apple-touch-icon" href="{% static 'assets/branding/giftbaaz-mark.svg' %}">
  <link rel="icon" href="{% static 'assets/branding/giftbaaz-mark.svg' %}" type="image/svg+xml">
  <link rel="apple-touch-icon" href="{% static 'assets/branding/giftbaaz-mark.svg' %}">

  <link rel="stylesheet" href="{% static 'css/style.css' %}">
  {% block extra_head %}{% endblock %}
</head>
<body class="app-shell">
  <div class="noise" aria-hidden="true"></div>
  <div class="ambient ambient-a" aria-hidden="true"></div>
  <div class="ambient ambient-b" aria-hidden="true"></div>

  <header class="site-header">
    <div class="announcement"><div class="container announcement-inner"><span><svg class="ui-icon ui-icon--sm"><use href="{% static 'assets/giftbaaz-ui.svg' %}#bolt"></use></svg>تحویل دیجیتال سریع</span><span>خرید امن و قابل پیگیری</span><span>پشتیبانی سفارش</span></div></div>
    <div class="container header-main">
      <a class="brand" href="{% url 'home' %}" aria-label="Giftbaaz">
        <img class="brand-mark-image" src="{% static 'assets/branding/giftbaaz-mark.svg' %}" alt="Giftbaaz"><span class="brand-text">Giftbaaz</span>
      </a>
      <form class="global-search" action="{% url 'shop' %}" method="get" role="search">
        <span class="search-icon" aria-hidden="true"><svg class="ui-icon"><use href="{% static 'assets/giftbaaz-ui.svg' %}#search"></use></svg></span>
        <input name="q" value="{{ request.GET.q }}" placeholder="محصول، گیفت کارت یا دسته‌بندی..." autocomplete="off">
        <button type="submit">جستجو</button>
      </form>
      <div class="header-actions">
        {% if user.is_authenticated %}
          <a class="icon-action" href="{% url 'account' %}"><span><svg class="ui-icon"><use href="{% static 'assets/giftbaaz-ui.svg' %}#user"></use></svg></span><b>حساب</b></a>
        {% else %}
          <a class="icon-action" href="{% url 'login' %}"><span><svg class="ui-icon"><use href="{% static 'assets/giftbaaz-ui.svg' %}#user"></use></svg></span><b>ورود</b></a>
        {% endif %}
        <a class="cart-action" href="{% url 'cart' %}"><span><svg class="ui-icon"><use href="{% static 'assets/giftbaaz-ui.svg' %}#cart"></use></svg></span><b>سبد</b>{% if cart_count %}<em>{{ cart_count }}</em>{% endif %}</a>
      </div>
    </div>
    <nav class="nav-wrap">
      <div class="container nav-inner">
        <a class="nav-link is-active" href="{% url 'home' %}">خانه</a>
        <a class="nav-link" href="{% url 'shop' %}">فروشگاه</a>
        <a class="nav-link" href="{% url 'shop' %}">گیفت کارت</a>
        <a class="nav-link" href="{% url 'shop' %}">دسته‌بندی‌ها</a>
        {% if user.is_authenticated %}<a class="nav-link" href="{% url 'orders' %}">سفارش‌های من</a>{% endif %}
      </div>
    </nav>
  </header>

  {% if messages %}
  <div class="container message-stack">
    {% for message in messages %}
      <div class="toast toast-{{ message.tags|default:'info' }}" role="status"><span>{{ message }}</span><button type="button" data-dismiss-toast aria-label="بستن">×</button></div>
    {% endfor %}
  </div>
  {% endif %}

  <main class="page-content">{% block content %}{% endblock %}</main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div><a class="brand footer-brand" href="{% url 'home' %}"><span class="brand-mark">G</span><span class="brand-text">Giftbaaz</span></a><p>فروشگاه محصولات دیجیتال با تجربه خرید سریع، شفاف و حرفه‌ای.</p></div>
      <div><h3>دسترسی سریع</h3><a href="{% url 'home' %}">خانه</a><a href="{% url 'shop' %}">فروشگاه</a>{% if user.is_authenticated %}<a href="{% url 'orders' %}">سفارش‌ها</a>{% endif %}</div>
      <div><h3>خرید</h3><a href="{% url 'shop' %}">همه محصولات</a><a href="{% url 'cart' %}">سبد خرید</a><a href="{% url 'shop' %}">دسته‌بندی‌ها</a></div>
      <div><h3>راهنما</h3><a href="{% url 'faq' %}">سؤالات متداول</a><a href="{% url 'guide' %}">راهنمای خرید</a><a href="{% url 'terms' %}">قوانین</a><a href="{% url 'privacy' %}">حریم خصوصی</a><a href="{% url 'contact' %}">تماس با ما</a></div>
    </div>
    <div class="container footer-bottom"><span>© 2026 Giftbaaz</span><span>ساخته‌شده برای تجربه‌ای سریع و ساده</span></div>
  </footer>

  <nav class="mobile-bottom-nav" aria-label="ناوبری موبایل">
    <a href="{% url 'home' %}"><svg class="ui-icon"><use href="{% static 'assets/giftbaaz-ui.svg' %}#home"></use></svg><span>خانه</span></a><a href="{% url 'shop' %}"><svg class="ui-icon"><use href="{% static 'assets/giftbaaz-ui.svg' %}#search"></use></svg><span>فروشگاه</span></a><a href="{% url 'cart' %}"><svg class="ui-icon"><use href="{% static 'assets/giftbaaz-ui.svg' %}#cart"></use></svg><span>سبد</span></a>
    {% if user.is_authenticated %}<a href="{% url 'account' %}">◉<span>حساب</span></a>{% else %}<a href="{% url 'login' %}">◉<span>ورود</span></a>{% endif %}
  </nav>

  <script src="{% static 'js/app.js' %}" defer></script>
  {% block extra_js %}{% endblock %}
</body>
</html>