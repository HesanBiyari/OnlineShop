# Giftbaaz production environment template.
#
# Copy the values into cPanel's "Environment variables" panel or into a
# server-only .env file. Never commit real secrets. The settings package
# defaults to production; set DJANGO_ENV explicitly to avoid surprises.

# production | development | test
DJANGO_ENV=production

DJANGO_DEBUG=false
# Must be replaced with 50+ random characters; production refuses to start
# with the short placeholder.
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_ALLOWED_HOSTS=giftbazz.ir,www.giftbazz.ir
DJANGO_CSRF_TRUSTED_ORIGINS=https://giftbazz.ir,https://www.giftbazz.ir

SITE_NAME=Giftbaaz
SITE_DOMAIN=giftbazz.ir
# Optional absolute base URL used when no request is available.
SITE_URL=https://giftbazz.ir

# SQLite is rejected when production settings are active.
DJANGO_DB_ENGINE=django.db.backends.mysql
DJANGO_DB_NAME=CHANGE_ME
DJANGO_DB_USER=CHANGE_ME
DJANGO_DB_PASSWORD=CHANGE_ME
# "localhost" normally uses the cPanel MySQL socket on shared hosting.
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=3306
DJANGO_DB_CONN_MAX_AGE=60

# The database itself must be created as:
#   CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci
# Otherwise Persian/Arabic inserts fail with MySQL error 1366.

DJANGO_MEDIA_ROOT=/home/CPANEL_USER/giftbaaz/media

DJANGO_SECURE_SSL_REDIRECT=true
# Start with 0, verify HTTPS, then raise to 31536000.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin
DJANGO_SECURE_REFERRER_POLICY=same-origin
# Passenger/LiteSpeed terminates TLS and forwards X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL=true

# Login throttling (per process, cache-backed).
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900

# Upload limits (bytes).
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
PRODUCT_IMAGE_MAX_BYTES=5242880
PRODUCT_IMAGE_MAX_DIMENSION=4000
DIGITAL_CODE_IMPORT_MAX_BYTES=2097152
DIGITAL_CODE_IMPORT_MAX_ROWS=10000

PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=CHANGE_ME
# Keep true only for staging; production should be false.
ZARINPAL_SANDBOX=false
# IRR is Rial, IRT is Toman. The site stores prices in Toman.
PAYMENT_CURRENCY=IRR
PAYMENT_TIMEOUT=15
# Reuse a recent gateway authority instead of creating a second live one.
PAYMENT_REDIRECT_REUSE_SECONDS=1800
# A process that died mid-initiation can be retried after this delay.
PAYMENT_INITIATING_STALE_SECONDS=120
# Cron re-verifies attempts stuck in "verifying" after this delay.
PAYMENT_VERIFYING_STALE_SECONDS=300
# Abandoned unpaid orders are cancelled and their coupon released after this.
ORDER_PENDING_EXPIRY_HOURS=24

DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=no-reply@giftbazz.ir

DJANGO_LOG_LEVEL=INFO
