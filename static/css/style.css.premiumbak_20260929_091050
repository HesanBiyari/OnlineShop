/* Giftbaaz Final Dimension System v2 */
/* Replaces v1 calibration with one deterministic sizing layer. */

:root{
  --gb-container: 1200px;
  --gb-gutter: 40px;
  --gb-section-y: 72px;
  --gb-card-radius: 20px;
}

.container{width:min(var(--gb-container),calc(100% - var(--gb-gutter)));margin-inline:auto}

/* Header */
.header-main{grid-template-columns:auto minmax(320px,620px) auto;gap:20px;padding:14px 0}
.brand{gap:10px;min-width:max-content}
.brand-mark-image{width:42px;height:42px;flex:0 0 42px;object-fit:contain}
.brand-text{font-size:20px;line-height:1}
.global-search{min-height:44px}
.global-search input{padding:10px 12px;font-size:13px}
.global-search button{min-height:42px;padding:10px 18px;font-size:12px}
.header-actions{gap:8px}
.icon-action,.cart-action{min-height:42px;padding:8px 11px}
.nav-inner{gap:26px}
.nav-link{padding:11px 0}

/* Home / hero */
.hero{padding:68px 0 76px}
.hero-grid{grid-template-columns:minmax(0,1.02fr) minmax(360px,.98fr);gap:46px;align-items:center}
.hero-copy{max-width:620px}
.hero-kicker,.eyebrow{font-size:11px;margin-bottom:9px}
.hero h1{font-size:clamp(42px,5vw,68px);line-height:1.16;letter-spacing:-1.4px;margin:8px 0 20px}
.hero-copy p{font-size:15px;line-height:2;max-width:590px}
.hero-actions{margin:26px 0}
.btn{min-height:44px;padding:10px 17px;font-size:12px}
.hero-proof{gap:14px;font-size:10px}
.hero-visual{height:auto;min-height:0;display:flex;justify-content:center;align-items:center;overflow:visible;transform:none}
.hero-art{width:100%;max-width:600px;height:auto;aspect-ratio:1200 / 700;object-fit:contain;display:block}

/* Sections */
.section{padding:var(--gb-section-y) 0}
.section-head{margin-bottom:25px;gap:18px}
.section-head h2{font-size:27px;line-height:1.45}
.page-hero{padding:50px 0 26px}
.page-hero h1{font-size:42px;line-height:1.25;margin-bottom:7px}
.page-hero p{font-size:14px}

/* Category cards */
.category-grid{grid-template-columns:repeat(5,minmax(0,1fr));gap:14px}
.category-card{min-height:148px;padding:17px 18px;border-radius:18px;gap:5px}
.category-icon{width:40px;height:40px;margin-bottom:10px}
.category-icon .ui-icon{width:28px;height:28px}
.category-card strong{font-size:13px}
.category-card small{font-size:9px}

/* Product cards */
.product-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
.product-card{border-radius:18px}
.product-media{height:auto;aspect-ratio:16 / 10;min-height:0}
.product-card-body{padding:14px 15px 15px}
.product-card h3{font-size:13px;line-height:1.65;min-height:42px;margin:3px 0 11px}
.price-row{margin-bottom:12px}
.price-row strong{font-size:15px}
.price-row small{font-size:8px}
.stock-dot{font-size:8px}
.card-cta{padding-top:10px;font-size:10px}
.discount-badge{top:10px;right:10px;padding:4px 7px;font-size:9px}
.bestseller-badge{top:10px;left:10px;padding:4px 8px;font-size:9px}
.product-placeholder{font-size:56px}

/* Shop */
.shop-toolbar{margin-bottom:22px}
.shop-layout{grid-template-columns:210px minmax(0,1fr);gap:22px}
.filter-box{padding:16px;border-radius:18px}
.shop-results-wrap{min-width:0}
.results-meta{margin-bottom:14px;font-size:10px}

/* Product detail */
.product-detail-grid{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:22px}
.gallery-card{padding:12px;border-radius:22px}
.product-main-media{height:auto;aspect-ratio:4 / 3;min-height:0;max-height:480px;border-radius:16px}
.product-info-panel{padding:24px;border-radius:22px}
.product-info-panel h1{font-size:32px;line-height:1.35;margin:4px 0 13px}
.product-description{font-size:12px;line-height:2;margin-bottom:19px}
.detail-price{margin:21px 0}
.detail-price strong{font-size:28px}
.variant-panel{margin:15px 0;padding:15px;border-radius:16px}
.variant-option{padding:11px 12px;border-radius:12px}
.product-thumbnails img{width:58px;height:58px}
.related{margin-top:62px}
.advanced-product-panel{margin-top:24px;padding:20px;border-radius:19px}

/* Cart / checkout / orders */
.cart-layout,.checkout-layout,.order-detail-layout{grid-template-columns:minmax(0,1fr) 320px;gap:20px}
.cart-item{grid-template-columns:82px minmax(0,1fr) 82px 120px 40px;gap:13px;padding:12px;border-radius:16px}
.cart-media{width:82px;height:68px;border-radius:11px}
.summary-card{padding:20px;border-radius:18px}
.checkout-card{padding:22px;border-radius:20px}
.order-card{padding:15px;gap:13px;border-radius:16px}
.order-item{padding:15px}
.order-meta{padding:16px}

/* Account */
.account-top{gap:8px;margin-bottom:34px}
.advanced-account-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.advanced-link{padding:15px;border-radius:16px;min-height:104px}
.referral-card,.kpi-card{padding:22px}
.page-visual{width:56px;height:56px;margin-bottom:12px;border-radius:15px}
.page-visual .ui-icon{width:36px;height:36px}

/* Auth */
.auth-page{min-height:0;width:min(100% - var(--gb-gutter),960px);grid-template-columns:minmax(0,1fr) 400px;gap:48px;padding:56px 0}
.auth-visual h1{font-size:42px;line-height:1.3;margin:6px 0 12px}
.auth-visual p{font-size:13px;line-height:2}
.auth-art{width:min(100%,340px);height:auto;max-height:none;aspect-ratio:900 / 620;object-fit:contain;margin:0 auto 18px}
.auth-card{padding:25px;border-radius:22px}
.auth-card h2,.auth-card h1{font-size:28px}
.form-subtitle{margin-bottom:21px}

/* Shared icon sizes */
.ui-icon--lg{width:54px;height:54px}
.ui-icon--xl{width:70px;height:70px}
.empty-state{padding:56px 18px}
.empty-state>div .ui-icon{width:68px;height:68px}

/* Tablet */
@media(max-width:1100px){
  :root{--gb-gutter:32px}
  .header-main{grid-template-columns:auto minmax(260px,1fr) auto}
  .hero-grid{grid-template-columns:minmax(0,1fr) minmax(320px,.9fr);gap:30px}
  .hero-art{max-width:520px}
  .category-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
  .product-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
  .advanced-account-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}

/* Narrow tablet */
@media(max-width:850px){
  :root{--gb-section-y:58px}
  .header-main{grid-template-columns:auto auto;justify-content:space-between}
  .global-search{grid-column:1 / -1;grid-row:2}
  .hero{padding:52px 0 60px}
  .hero-grid{grid-template-columns:1fr;gap:22px}
  .hero-visual{order:-1}
  .hero-art{width:min(100%,520px);max-width:520px}
  .hero-copy{max-width:none;text-align:center}
  .hero-copy p{margin-inline:auto}
  .hero-actions,.hero-proof{justify-content:center}
  .product-detail-grid{grid-template-columns:1fr;gap:16px}
  .product-main-media{max-height:none}
  .auth-page{grid-template-columns:1fr;gap:28px;padding:45px 0}
  .auth-visual{text-align:center}
  .auth-art{width:min(100%,330px)}
  .shop-layout,.cart-layout,.checkout-layout,.order-detail-layout{grid-template-columns:1fr}
  .filter-panel,.summary-card{position:static}
}

