  .footer-grid{grid-template-columns:1fr 1fr;gap:22px;padding:38px 0}
  .footer-bottom{padding:14px 0}
  .site-footer{padding-bottom:72px}
  .mobile-bottom-nav a{gap:3px}
  .mobile-bottom-nav .ui-icon{width:21px;height:21px}
  .mobile-bottom-nav span{font-size:8px}
}

/* Prevent flex/grid children from forcing width overflow. */
.hero-grid>* , .product-detail-grid>* , .auth-page>* , .cart-layout>* , .checkout-layout>* , .order-detail-layout>*{min-width:0}
img,svg{max-width:100%}

/* Giftbaaz Motion System v4 */

:root{
  --gb-motion-fast:180ms;
  --gb-motion-med:380ms;
  --gb-motion-slow:650ms;
  --gb-motion-ease:cubic-bezier(.22,.61,.36,1);
}

/* Scroll progress */
.scroll-progress{
  position:fixed;
  z-index:120;
  top:0;
  right:0;
  left:0;
  height:2px;
  pointer-events:none;
  overflow:hidden;
}
.scroll-progress span{
  display:block;
  width:100%;
  height:100%;
  transform:scaleX(0);
  transform-origin:right center;
  background:linear-gradient(90deg,var(--primary2),var(--primary));
  box-shadow:0 0 12px rgba(139,92,246,.4);
}

/* Header */
.site-header{
  transition:
    background var(--gb-motion-med) var(--gb-motion-ease),
    box-shadow var(--gb-motion-med) var(--gb-motion-ease);
}
.site-header.is-scrolled{
  background:rgba(7,9,16,.74);
  box-shadow:0 12px 38px rgba(0,0,0,.12);
}
.site-header.is-scrolled .header-main{
  padding-top:8px;
  padding-bottom:8px;
}

/* Progressive reveal */
.reveal,
.motion-target{
  opacity:1;
  transform:none;
  filter:none;
}
body.motion-enabled .motion-target{
  opacity:0;
  transform:translate3d(0,22px,0) scale(.985);
  filter:blur(2px);
  transition:
    opacity var(--gb-motion-slow) var(--gb-motion-ease),
    transform var(--gb-motion-slow) var(--gb-motion-ease),
    filter var(--gb-motion-slow) var(--gb-motion-ease);
  transition-delay:calc(var(--motion-index,0) * 48ms);
}
body.motion-enabled .motion-target.is-visible{
  opacity:1;
  transform:none;
  filter:none;
}

/* Ambient background — intentionally slow and subtle */
.ambient{
  transform:translate3d(0,0,0);
  animation:gb-ambient 15s ease-in-out infinite alternate;
}
.ambient-b{animation-delay:-6s}
@keyframes gb-ambient{
  from{transform:translate3d(0,0,0) scale(1)}
  to{transform:translate3d(16px,-12px,0) scale(1.035)}
}

/* Hero */
.hero-visual{
  --gb-mx:50%;
  --gb-my:50%;
}
.hero-visual::after{
  content:"";
  position:absolute;
  inset:8%;
  pointer-events:none;
  border-radius:50%;
  background:radial-gradient(circle at var(--gb-mx) var(--gb-my),rgba(139,92,246,.13),transparent 34%);
  opacity:.7;
  transition:opacity 300ms ease;
}
.hero-art{
  position:relative;
  z-index:1;
  animation:gb-hero-float 8s ease-in-out infinite;
  will-change:transform;
}
@keyframes gb-hero-float{
  0%,100%{transform:translate3d(0,0,0)}
  50%{transform:translate3d(0,-8px,0)}
}

/* CTA energy */
.btn{
  transform:translateY(0);
  transition:
    transform var(--gb-motion-fast) var(--gb-motion-ease),
    box-shadow var(--gb-motion-fast) var(--gb-motion-ease),
    border-color var(--gb-motion-fast) ease,
    filter var(--gb-motion-fast) ease;
}
.btn:hover{filter:brightness(1.08)}
.btn:active{transform:translateY(1px) scale(.985)}
.btn-primary{
  background-size:180% 180%;
  animation:gb-button-shift 7s ease-in-out infinite;
}
@keyframes gb-button-shift{
  0%,100%{background-position:0% 50%}
  50%{background-position:100% 50%}
}

/* Cards */
.category-card,
.product-card,
.step,
.advanced-link{
  transition:
    transform var(--gb-motion-med) var(--gb-motion-ease),
    box-shadow var(--gb-motion-med) var(--gb-motion-ease),
    border-color var(--gb-motion-med) ease,
    background var(--gb-motion-med) ease;
}
.category-card:hover,
.step:hover,
.advanced-link:hover{
  transform:translate3d(0,-5px,0);
}
.product-card:hover{
  transform:translate3d(0,-7px,0);
}

.category-card .category-icon{
  transition:
    transform var(--gb-motion-med) var(--gb-motion-ease),
    background var(--gb-motion-med) ease,
    box-shadow var(--gb-motion-med) ease;
}
.category-card:hover .category-icon{
  transform:rotate(-4deg) scale(1.06);
  box-shadow:0 10px 28px rgba(139,92,246,.12);
}
.category-card .category-icon .ui-icon{
  transition:transform var(--gb-motion-med) var(--gb-motion-ease);
}
.category-card:hover .category-icon .ui-icon{
  transform:scale(1.08) rotate(4deg);
}

/* Product media */
.product-media{isolation:isolate}
.product-media img{
  opacity:0;
  transition:
    transform 600ms var(--gb-motion-ease),
    opacity 420ms ease,
    filter 380ms ease;
}
.product-media img.image-ready{opacity:1}
.product-card:hover .product-media img{
  transform:scale(1.055);
  filter:saturate(1.04) brightness(1.035);
}
.media-shine{
  opacity:.62;
  transition:opacity 300ms ease;
}
.product-card:hover .media-shine{opacity:1}
.discount-badge,
.bestseller-badge{
  transition:
    transform var(--gb-motion-fast) var(--gb-motion-ease),
    box-shadow var(--gb-motion-fast) ease;
}
.product-card:hover .discount-badge,
.product-card:hover .bestseller-badge{
  transform:translateY(-2px);
}

/* Gallery */
.product-thumbnail{
  transition:
    transform var(--gb-motion-fast) var(--gb-motion-ease),
    border-color var(--gb-motion-fast) ease,
    box-shadow var(--gb-motion-fast) ease;
}
.product-thumbnail:hover{transform:translateY(-2px)}
.product-main-media img.image-switching{
  animation:gb-image-switch 360ms var(--gb-motion-ease);
}
@keyframes gb-image-switch{
  0%{opacity:.35;transform:scale(.985)}
  100%{opacity:1;transform:scale(1)}
}

/* Panels */
.gallery-card,
.product-info-panel,
.auth-card,
.summary-card,
.checkout-card{
  transition:
    transform var(--gb-motion-med) var(--gb-motion-ease),
    box-shadow var(--gb-motion-med) ease,
    border-color var(--gb-motion-med) ease;
}
@media(min-width:801px){
  .gallery-card:hover,
  .product-info-panel:hover,
  .auth-card:hover,
  .summary-card:hover{
    transform:translate3d(0,-3px,0);
    box-shadow:0 28px 70px rgba(0,0,0,.20);
  }
}

/* Navigation */
.nav-link{transition:color var(--gb-motion-fast) ease}
.nav-link::after{
  transform:scaleX(0);
  transform-origin:center;
  transition:transform var(--gb-motion-med) var(--gb-motion-ease);
}
.nav-link.is-active::after{transform:scaleX(1)}

/* Mobile navigation */
.mobile-bottom-nav a{
  transition:
    color var(--gb-motion-fast) ease,
    transform var(--gb-motion-fast) var(--gb-motion-ease);
}
.mobile-bottom-nav a.is-current{
  color:#fff;
  transform:translateY(-2px);
}
.mobile-bottom-nav a.is-current .ui-icon{
  filter:drop-shadow(0 0 8px rgba(139,92,246,.35));
}

/* Toast */
.toast{transition:opacity 220ms ease,transform 220ms ease}
.toast.is-fading{opacity:0;transform:translateY(-6px)}

/* Navigation/page transition */
.page-content{transition:opacity 180ms ease,transform 180ms ease}
body.page-leaving .page-content{
  opacity:.60;
  transform:translateY(4px);
}

/* Small status accents */
.status-pill,
.variant-option.is-selected,
.discount-badge,
.bestseller-badge{
  will-change:transform;
}

/* Responsive */
@media(max-width:800px){
  .site-header.is-scrolled .header-main{
    padding-top:7px;
    padding-bottom:7px;
  }
  .ambient{animation-duration:18s}
  .hero-art{animation-duration:9s}
  .hero-visual::after{opacity:.45}
}

@media(max-width:600px){
  .category-card:hover,
  .product-card:hover,
  .step:hover,
  .advanced-link:hover{
    transform:none;
  }
  .scroll-progress{height:2px}
}

/* Accessibility */
@media(prefers-reduced-motion:reduce){
  *,
  *::before,
  *::after{
    animation-duration:.01ms!important;
    animation-iteration-count:1!important;
    transition-duration:.01ms!important;
    scroll-behavior:auto!important;
  }

  .motion-target,
  body.motion-enabled .motion-target,
  body.motion-enabled .motion-target.is-visible{
    opacity:1!important;
    transform:none!important;
    filter:none!important;
  }

  body.page-leaving .page-content{
    opacity:1!important;
    transform:none!important;
  }
}
